# Copy this file to .env and fill in the values. Never commit .env.

# --- Company / persona ---
COMPANY_NAME=
AGENT_NAME=Ava
# IANA timezone used for "today", availability and bookings
BUSINESS_TIMEZONE=America/New_York
# Optional: override the first line the agent speaks
# GREETING=
# Seconds of silence before the agent assumes you finished talking. Lower = snappier
# but interrupts you more; higher = more patient but slower to reply.
VAD_STOP_SECS=0.6

# --- Speech-to-Text and Text-to-Speech: https://console.deepgram.com ---
DEEPGRAM_API_KEY=
# Aura-2 voice. Others: aura-2-thalia-en, aura-2-andromeda-en, aura-2-orion-en (male),
# aura-2-arcas-en (male). Listen at https://playground.deepgram.com
DEEPGRAM_VOICE=aura-2-helena-en

# --- LLM providers. Both free. The first in LLM_ORDER is used; the next takes over
# when it fails or is rate-limited. Gemini first: Groq's free tier (8K tokens/min, no
# discount for the repeated prompt) only manages ~2 exchanges a minute.
LLM_ORDER=gemini,groq

# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# flash-lite answers in ~1s; gemini-3.6-flash is smarter but 2-4s
GEMINI_MODEL=gemini-3.5-flash-lite

# Groq: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# low | medium | high. Leave empty for models without reasoning support.
GROQ_REASONING_EFFORT=low


# --- Email notifications for callback messages and bookings (Brevo, free 300/day) ---
# https://app.brevo.com -> SMTP & API -> API keys. The FROM address must be a verified
# sender in Brevo (Senders & IPs). NOTIFY_TO may list several addresses, comma-separated.
# Test with: python notify.py
BREVO_API_KEY=
NOTIFY_TO=
NOTIFY_FROM_EMAIL=
NOTIFY_FROM_NAME=Voice Agent

# --- Phone (later, when the client buys the number) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# --- Booking: Google Calendar (optional) ---
# Run `python authorize_google.py` once (steps inside that file). Without it the agent
# takes a callback message instead of booking. These fall back to the intake document's
# "Basics" table when set there.
GOOGLE_CALENDAR_ID=primary
BOOKABLE_HOURS=Mon-Fri 09:00-17:00
APPOINTMENT_MINUTES=30
APPOINTMENT_TITLE=Discovery call
